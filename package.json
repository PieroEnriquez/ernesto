    },
    "@cursor/sdk": {
      "optional": true
    },
    "@mariozechner/pi-agent-core": {
      "optional": true
    },
    "@mariozechner/pi-ai": {
      "optional": true
    }
  },
  "dependencies": {
    "@toon-format/toon": "^2.1.0",
    "debug": "^4",
    "js-yaml": "^4.1.0",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "picomatch": "^4.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3",
      "esbuild",
      "@google/genai",
      "protobufjs"
    ],
    "overrides": {
      "sqlite3": "^6.0.1"
    }
  }
}
