{
  "name": "ernesto",
  "version": "0.1.12",
  "description": "A Context System for Agent-Assisted Organizations",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc",
    "format": "prettier --check ./src",
    "build": "rollup -c rollup.config.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dashboards": {
      "types": "./dist/dashboards/index.d.ts",
      "import": "./dist/dashboards/index.js",
      "require": "./dist/dashboards/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    },
    "./harness": {
      "types": "./dist/harness/index.d.ts",
      "import": "./dist/harness/index.js",
      "require": "./dist/harness/index.cjs"
    },
    "./harness/cas": {
      "types": "./dist/harness/cas/index.d.ts",
      "import": "./dist/harness/cas/index.js",
      "require": "./dist/harness/cas/index.cjs"
    },
    "./harness/cursor": {
      "types": "./dist/harness/cursor/index.d.ts",
      "import": "./dist/harness/cursor/index.js",
      "require": "./dist/harness/cursor/index.cjs"
    },
    "./harness/fragua-pi": {
      "types": "./dist/harness/fragua-pi/index.d.ts",
      "import": "./dist/harness/fragua-pi/index.js",
      "require": "./dist/harness/fragua-pi/index.cjs"
    },
    "./harness/remote-vm": {
      "types": "./dist/harness/remote-vm/index.d.ts",
      "import": "./dist/harness/remote-vm/index.js",
      "require": "./dist/harness/remote-vm/index.cjs"
    },
    "./harness/mock": {
      "types": "./dist/harness/mock/index.d.ts",
      "import": "./dist/harness/mock/index.js",
      "require": "./dist/harness/mock/index.cjs"
    },
    "./workflows": {
      "types": "./dist/workflows/index.d.ts",
      "import": "./dist/workflows/index.js",
      "require": "./dist/workflows/index.cjs"
    },
    "./workflow-engine": {
      "types": "./dist/workflow-engine/index.d.ts",
      "import": "./dist/workflow-engine/index.js",
      "require": "./dist/workflow-engine/index.cjs"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.cjs"
    },
    "./ui-tools": {
      "types": "./dist/ui-tools/index.d.ts",
      "import": "./dist/ui-tools/index.js",
      "require": "./dist/ui-tools/index.cjs"
    },
    "./route": {
      "types": "./dist/route/index.d.ts",
      "import": "./dist/route/index.js",
      "require": "./dist/route/index.cjs"
    }
  },
  "contributors": [
    {
      "author": "Clement Rouquier"
    },
    {
      "author": "William Sandström <w.sandstrom@gmail.com>"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ask-ernesto/ernesto.git"
  },
  "keywords": [
    "ernesto",
    "mcp"
  ],
  "license": "ISC",
  "packageManager": "pnpm@10.22.0",
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.156",
    "@cursor/sdk": "1.0.13",
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@types/picomatch": "^4.0.3",
    "mcp-oauth-server": "^0.0.2",
    "prettier": "^3.7.3",
    "rollup": "^4.55.1",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "*",
    "@cursor/sdk": "^1.0.0",
    "@mariozechner/pi-agent-core": "^0.73.0",
    "@mariozechner/pi-ai": "^0.73.0",
    "@modelcontextprotocol/sdk": "^1.23.0",
